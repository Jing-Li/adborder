  "bodyPreExtra": "  <div class=\"cursor-blob\" id=\"cursorBlob\"></div>\n\n  <!-- Header -->\n  ",
  "revealSelectors": ".stage-demo-img",
  "postOverride": "<footer>\n    <nav aria-label=\"页脚导航\">\n    <div class=\"footer-links\">\n      <a href=\"/zh/\">首页</a>\n      <a href=\"/zh/blog.html\">博客</a>\n      <a href=\"/critique/\">AI 评论</a>\n      <a href=\"/models/\">模型排行榜</a>\n      <a href=\"/zh/about.html\">关于</a>\n      <a href=\"/zh/privacy.html\">隐私政策</a>\n      <a href=\"/zh/terms.html\">服务条款</a>\n      <a href=\"/zh/contact.html\">联系</a>\n      <a href=\"/zh/editorial.html\">编辑政策</a>\n    </div>\n    </nav>\n    <p class=\"footer-copy\">&copy; 2026 AdBorder.top</p>\n    <div class=\"footer-support\">\n      <p class=\"footer-support-text\">喜欢 AdBorder？帮我们保持免费。</p>\n      <a href=\"https://ko-fi.com/adborder\" target=\"_blank\" rel=\"noopener\" class=\"footer-support-btn\"><span>&#9749;</span> 支持我</a>\n    </div>\n  </footer>\n\n  <!-- Exit Intent Popup -->\n  <div class=\"exit-overlay\" id=\"exitOverlay\">\n    <div class=\"exit-popup\">\n      <button class=\"exit-close\" id=\"exitClose\" aria-label=\"关闭\">&times;</button>\n      <span class=\"exit-icon\">&#128064;</span>\n      <h3>等等！别空手离开</h3>\n      <p>几秒内上传图片，加上漂亮边框。完全免费、无需注册，图片 100% 保密。</p>\n      <button class=\"exit-cta\" id=\"exitCta\">立即免费试试</button>\n      <button class=\"exit-skip\" id=\"exitSkip\">不了，我稍后再来</button>\n    </div>\n  </div>\n\n\n\n  <!-- Cookie Banner -->\n    <div id=\"cookieBanner\" class=\"cookie-banner\">\n      <span>我们使用 Cookie 用于数据分析与广告。继续使用即表示您同意我们的 <a href=\"/zh/privacy.html\">隐私政策</a>.</span>\n      <button class=\"cookie-accept\" onclick=\"dismissCookie()\">接受</button>\n    </div>\n  <script>\n    (function(){\n      var cb = document.getElementById('cookieBanner');\n      if (!document.cookie.split(';').some(function(c){return c.trim().startsWith('adborder_consent=')})) {\n        cb.style.display = 'flex';\n      } else { cb.style.display = 'none'; }\n    })();\n    function dismissCookie() {\n      document.cookie = 'adborder_consent=1;max-age=31536000;path=/;SameSite=Lax';\n      document.getElementById('cookieBanner').style.display = 'none';\n    }\n  </script>\n\n  <script>\n    if ('serviceWorker' in navigator) {\n      navigator.serviceWorker.register('/sw.js').catch(() => {});\n    }\n  </script>\n\n  <script>\n    // ===== Cursor Blob =====\n    const blob = document.getElementById('cursorBlob');\n    let blobX = 0, blobY = 0, mouseX = 0, mouseY = 0;\n    document.addEventListener('mousemove', (e) => { mouseX = e.clientX; mouseY = e.clientY; });\n    function animateBlob() {\n      blobX += (mouseX - blobX) * 0.08;\n      blobY += (mouseY - blobY) * 0.08;\n      blob.style.left = blobX + 'px';\n      blob.style.top = blobY + 'px';\n      requestAnimationFrame(animateBlob);\n    }\n    animateBlob();\n\n    // ===== Particle System (upload stage) =====\n    const stageCanvas = document.getElementById('stageCanvas');\n    const stageEl = stageCanvas.closest('.upload-stage');\n    const stageCtx = stageCanvas.getContext('2d');\n    let particles = [];\n    let stageMouseX = -999, stageMouseY = -999;\n    let particleAnimId = null;\n\n    function resizeStageCanvas() {\n      const r = stageEl.getBoundingClientRect();\n      stageCanvas.width = r.width;\n      stageCanvas.height = r.height;\n    }\n    resizeStageCanvas();\n    window.addEventListener('resize', resizeStageCanvas);\n\n    stageEl.addEventListener('mousemove', (e) => {\n      const r = stageEl.getBoundingClientRect();\n      stageMouseX = e.clientX - r.left;\n      stageMouseY = e.clientY - r.top;\n    });\n    stageEl.addEventListener('mouseleave', () => { stageMouseX = -999; stageMouseY = -999; });\n\n    const PARTICLE_COUNT = 75;\n    const palette = [\n      {r:124,g:58,b:237},   // purple\n      {r:6,g:182,b:212},    // cyan\n      {r:244,g:63,b:94},    // pink\n      {r:167,g:139,b:250},  // light purple\n      {r:34,g:211,b:238}    // light cyan\n    ];\n\n    function initParticles() {\n      particles = [];\n      for (let i = 0; i < PARTICLE_COUNT; i++) {\n        const c = palette[Math.floor(Math.random() * palette.length)];\n        particles.push({\n          x: Math.random() * stageCanvas.width,\n          y: Math.random() * stageCanvas.height,\n          vx: (Math.random() - 0.5) * 0.4,\n          vy: (Math.random() - 0.5) * 0.4,\n          r: Math.random() * 2.5 + 1,\n          baseR: Math.random() * 2.5 + 1,\n          c,\n          alpha: Math.random() * 0.4 + 0.2,\n          baseAlpha: Math.random() * 0.4 + 0.2\n        });\n      }\n    }\n    initParticles();\n\n    function animateParticles() {\n      stageCtx.clearRect(0, 0, stageCanvas.width, stageCanvas.height);\n      const hovering = stageMouseX > -500;\n\n      // Update & draw particles\n      for (let i = 0; i < particles.length; i++) {\n        const p = particles[i];\n        if (hovering) {\n          const dx = stageMouseX - p.x;\n          const dy = stageMouseY - p.y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          if (dist < 160) {\n            const force = (160 - dist) / 160 * 0.022;\n            p.vx += dx * force;\n            p.vy += dy * force;\n            p.r = p.baseR + (160 - dist) / 160 * 3;\n            p.alpha = Math.min(p.baseAlpha + (160 - dist) / 160 * 0.4, 0.9);\n          } else {\n            p.r += (p.baseR - p.r) * 0.04;\n            p.alpha += (p.baseAlpha - p.alpha) * 0.04;\n          }\n        } else {\n          p.r += (p.baseR - p.r) * 0.04;\n          p.alpha += (p.baseAlpha - p.alpha) * 0.04;\n        }\n\n        p.x += p.vx;\n        p.y += p.vy;\n        p.vx *= 0.985;\n        p.vy *= 0.985;\n\n        if (p.x < -15) p.x = stageCanvas.width + 15;\n        if (p.x > stageCanvas.width + 15) p.x = -15;\n        if (p.y < -15) p.y = stageCanvas.height + 15;\n        if (p.y > stageCanvas.height + 15) p.y = -15;\n\n        // Glow halo\n        const glowR = p.r * 3.5;\n        const grad = stageCtx.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowR);\n        grad.addColorStop(0, 'rgba(' + p.c.r + ',' + p.c.g + ',' + p.c.b + ',' + (p.alpha * 0.35) + ')');\n        grad.addColorStop(1, 'rgba(' + p.c.r + ',' + p.c.g + ',' + p.c.b + ',0)');\n        stageCtx.fillStyle = grad;\n        stageCtx.beginPath();\n        stageCtx.arc(p.x, p.y, glowR, 0, Math.PI * 2);\n        stageCtx.fill();\n\n        // Core dot\n        stageCtx.fillStyle = 'rgba(' + p.c.r + ',' + p.c.g + ',' + p.c.b + ',' + p.alpha + ')';\n        stageCtx.beginPath();\n        stageCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);\n        stageCtx.fill();\n      }\n\n      // Connection lines (liquid metal web)\n      for (let i = 0; i < particles.length; i++) {\n        for (let j = i + 1; j < particles.length; j++) {\n          const dx = particles[i].x - particles[j].x;\n          const dy = particles[i].y - particles[j].y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          if (dist < 90) {\n            const alpha = (1 - dist / 90) * 0.12;\n            stageCtx.strokeStyle = 'rgba(124,58,212,' + alpha + ')';\n            stageCtx.lineWidth = 0.6;\n            stageCtx.beginPath();\n            stageCtx.moveTo(particles[i].x, particles[i].y);\n            stageCtx.lineTo(particles[j].x, particles[j].y);\n            stageCtx.stroke();\n          }\n        }\n      }\n\n      // Liquid metal cursor glow (bright blob near mouse when hovering)\n      if (hovering) {\n        const mg = stageCtx.createRadialGradient(stageMouseX, stageMouseY, 0, stageMouseX, stageMouseY, 60);\n        mg.addColorStop(0, 'rgba(13,148,136,0.08)');\n        mg.addColorStop(0.5, 'rgba(217,119,6,0.04)');\n        mg.addColorStop(1, 'rgba(0,0,0,0)');\n        stageCtx.fillStyle = mg;\n        stageCtx.beginPath();\n        stageCtx.arc(stageMouseX, stageMouseY, 60, 0, Math.PI * 2);\n        stageCtx.fill();\n      }\n\n      particleAnimId = requestAnimationFrame(animateParticles);\n    }\n    animateParticles();\n\n    // Demo image cycling (shows border style previews)\n    const demoImgs = document.querySelectorAll('.stage-demo-img');\n    let demoIndex = 0;\n    const demoInterval = setInterval(() => {\n      if (!stageEl || stageEl.classList.contains('has-image')) return;\n      demoImgs.forEach(img => img.classList.remove('active'));\n      demoIndex = (demoIndex + 1) % demoImgs.length;\n      demoImgs[demoIndex].classList.add('active');\n    }, 3500);\n\n    // Bloom animation trigger\n    function triggerBloom() {\n      const bloom = document.getElementById('bloomOverlay');\n      if (!bloom) return;\n      bloom.classList.remove('active');\n      void bloom.offsetWidth;\n      bloom.classList.add('active');\n      setTimeout(() => bloom.classList.remove('active'), 900);\n    }\n\n    // ===== Button Ripple Effect =====\n    document.querySelectorAll('.btn').forEach(btn => {\n      btn.addEventListener('click', function(e) {\n        const r = this.getBoundingClientRect();\n        const ripple = document.createElement('span');\n        ripple.className = 'ripple';\n        ripple.style.left = (e.clientX - r.left) + 'px';\n        ripple.style.top = (e.clientY - r.top) + 'px';\n        ripple.style.width = ripple.style.height = Math.max(r.width, r.height) + 'px';\n        this.appendChild(ripple);\n        setTimeout(() => ripple.remove(), 600);\n      });\n    });\n\n    // ===== Feature Card Mouse Glow =====\n    document.querySelectorAll('.feature-card').forEach(card => {\n      card.addEventListener('mousemove', (e) => {\n        const r = card.getBoundingClientRect();\n        card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');\n        card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');\n      });\n    });\n\n    // ===== Scroll Reveal =====\n    const revealObserver = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('visible');\n          revealObserver.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.1 });\n    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));\n\n    // ===== State =====\n    let state = {\n      style: 'solid',\n      width: 20,\n      color: '#ffffff',\n      gradient1: '#667eea',\n      gradient2: '#764ba2',\n      radius: 10,\n      shadow: false,\n      format: 'png',\n      socialPreset: null,\n      images: [],\n      activeIndex: 0,\n    };\n\n    const MAX_DIM = 8192;\n\n    // ===== Upload Handling =====\n    const uploadZone = document.getElementById('uploadZone');\n    const fileInput = document.getElementById('fileInput');\n    const previewWrapper = document.getElementById('previewWrapper');\n\n    uploadZone.addEventListener('click', () => fileInput.click());\n    uploadZone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });\n    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('dragover'); });\n    uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));\n    uploadZone.addEventListener('drop', (e) => { e.preventDefault(); uploadZone.classList.remove('dragover'); handleFiles(e.dataTransfer.files); });\n    fileInput.addEventListener('change', (e) => handleFiles(e.target.files));\n    document.addEventListener('paste', (e) => {\n      const items = e.clipboardData?.items;\n      if (!items) return;\n      const files = [];\n      for (const item of items) { if (item.type.startsWith('image/')) files.push(item.getAsFile()); }\n      if (files.length) handleFiles(files);\n    });\n\n    function handleFiles(fileList) {\n      const files = Array.from(fileList).filter(f => f.type.startsWith('image/'));\n      if (!files.length) return;\n      state.images = [];\n      state.activeIndex = 0;\n      const promises = files.map((file, i) => {\n        return new Promise((resolve) => {\n          const img = new Image();\n          const url = URL.createObjectURL(file);\n          img.onload = () => {\n            if (img.width > MAX_DIM || img.height > MAX_DIM) {\n              const scale = MAX_DIM / Math.max(img.width, img.height);\n              const canvas = document.createElement('canvas');\n              canvas.width = Math.round(img.width * scale);\n              canvas.height = Math.round(img.height * scale);\n              const ctx = canvas.getContext('2d');\n              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);\n              const scaledImg = new Image();\n              scaledImg.onload = () => {\n                state.images.push({ file, img: scaledImg, name: file.name || `image-${i}.png` });\n                URL.revokeObjectURL(url);\n                resolve();\n              };\n              scaledImg.src = canvas.toDataURL();\n            } else {\n              state.images.push({ file, img, name: file.name || `image-${i}.png` });\n              URL.revokeObjectURL(url);\n              resolve();\n            }\n          };\n          img.src = url;\n        });\n      });\n      Promise.all(promises).then(() => { triggerBloom(); showTool(); renderPreview(); updateBatchUI(); });\n    }\n\n    function showTool() {\n      uploadZone.classList.add('hidden', 'has-image');\n      previewWrapper.classList.add('active');\n      if (particleAnimId) { cancelAnimationFrame(particleAnimId); particleAnimId = null; }\n    }\n    function resetTool() {\n      state.images = []; state.activeIndex = 0;\n      uploadZone.classList.remove('hidden', 'has-image');\n      previewWrapper.classList.remove('active');\n      document.getElementById('batchArea').classList.remove('active');\n      fileInput.value = '';\n      document.getElementById('batchDownloadBtn').style.display = 'none';\n      if (!particleAnimId) animateParticles();\n    }\n\n    // ===== Controls =====\n    function setStyle(el, style) {\n      document.querySelectorAll('.style-btn').forEach(b => b.classList.remove('active'));\n      el.classList.add('active'); state.style = style;\n      document.getElementById('colorGroup').style.display = (style === 'gradient') ? 'none' : '';\n      document.getElementById('gradientGroup').style.display = (style === 'gradient') ? '' : 'none';\n      document.getElementById('radiusGroup').style.display = (style === 'rounded') ? '' : 'none';\n      if (style === 'polaroid') { state.color = '#ffffff'; document.getElementById('borderColor').value = '#ffffff'; updateSwatchActive('#ffffff'); }\n      renderPreview();\n    }\n    function updateWidth(val) { state.width = parseInt(val); document.getElementById('widthValue').textContent = val + 'px'; renderPreview(); }\n    function setWidth(val) { document.getElementById('borderWidth').value = val; updateWidth(val); }\n    function updateColor(val) { state.color = val; updateSwatchActive(val); renderPreview(); }\n    function pickColor(el) { const color = el.dataset.color; state.color = color; document.getElementById('borderColor').value = color; updateSwatchActive(color); renderPreview(); }\n    function updateSwatchActive(color) { document.querySelectorAll('.color-swatch').forEach(s => { s.classList.toggle('active', s.dataset.color.toLowerCase() === color.toLowerCase()); }); }\n    function pickGradient(el) { document.querySelectorAll('.gradient-btn').forEach(b => b.classList.remove('active')); el.classList.add('active'); state.gradient1 = el.dataset.g1; state.gradient2 = el.dataset.g2; renderPreview(); }\n    function updateRadius(val) { state.radius = parseInt(val); document.getElementById('radiusValue').textContent = val + '%'; renderPreview(); }\n    function setFormat(el, format) { document.querySelectorAll('.format-btn').forEach(b => b.classList.remove('active')); el.classList.add('active'); state.format = format; document.getElementById('qualityGroup').style.display = format === 'jpeg' ? '' : 'none'; }\n    function applySocial(el, preset) {\n      document.querySelectorAll('.social-btn').forEach(b => b.classList.remove('active')); el.classList.add('active'); state.socialPreset = preset;\n      if (preset === 'square' || preset === 'story' || preset === 'post') {\n        state.style = 'solid'; state.color = '#ffffff'; state.width = 0;\n        document.getElementById('borderColor').value = '#ffffff'; updateSwatchActive('#ffffff'); setStyleBtn('solid');\n      } else { state.socialPreset = null; }\n      renderPreview();\n    }\n    function setStyleBtn(style) {\n      document.querySelectorAll('.style-btn').forEach(b => { b.classList.toggle('active', b.dataset.style === style); });\n      document.getElementById('colorGroup').style.display = (style === 'gradient') ? 'none' : '';\n      document.getElementById('gradientGroup').style.display = (style === 'gradient') ? '' : 'none';\n      document.getElementById('radiusGroup').style.display = (style === 'rounded') ? '' : 'none';\n    }\n\n    // ===== Rendering =====\n    function computeBorderParams(img, borderStyle, borderWidth, socialPreset) {\n      const w = img.width, h = img.height;\n      if (socialPreset === 'square') { const side = Math.max(w, h); const bw = Math.max(borderWidth, Math.round((side - w) / 2)); const bh = Math.max(borderWidth, Math.round((side - h) / 2)); return { totalW: w + bw * 2, totalH: h + bh * 2, bx: bw, by: bh }; }\n      if (socialPreset === 'story') { const tr = 9/16; const cr = w/h; let tw,th; if(cr>tr){tw=w;th=Math.round(w/tr);}else{th=h;tw=Math.round(h*tr);} const bx=Math.max(borderWidth,Math.round((tw-w)/2)); const by=Math.max(borderWidth,Math.round((th-h)/2)); return{totalW:w+bx*2,totalH:h+by*2,bx,by}; }\n      if (socialPreset === 'post') { const tr=16/9; const cr=w/h; let tw,th; if(cr>tr){tw=w;th=Math.round(w/tr);}else{th=h;tw=Math.round(h*tr);} const bx=Math.max(borderWidth,Math.round((tw-w)/2)); const by=Math.max(borderWidth,Math.round((th-h)/2)); return{totalW:w+bx*2,totalH:h+by*2,bx,by}; }\n      if (borderStyle === 'polaroid') { const bw = borderWidth; const bb = Math.round(bw * 3); return { totalW: w + bw * 2, totalH: h + bw + bb, bx: bw, by: bw, bottomBorder: bb }; }\n      return { totalW: w + borderWidth * 2, totalH: h + borderWidth * 2, bx: borderWidth, by: borderWidth };\n    }\n\n    function renderToCanvas(canvas, img, opts, isPreview) {\n      const { style, width: bw, color, gradient1, gradient2, radius, shadow, socialPreset } = opts;\n      const params = computeBorderParams(img, style, bw, socialPreset);\n      let scale = 1;\n      if (isPreview) { scale = Math.min(800 / params.totalW, 500 / params.totalH, 1); }\n      canvas.width = Math.round(params.totalW * scale); canvas.height = Math.round(params.totalH * scale);\n      const ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, canvas.width, canvas.height);\n      const sx = Math.round(params.bx * scale), sy = Math.round(params.by * scale), sw = Math.round(img.width * scale), sh = Math.round(img.height * scale);\n      if (shadow) {\n        ctx.save();\n        ctx.shadowColor = 'rgba(0,0,0,0.5)';\n        ctx.shadowBlur = 40 * scale;\n        ctx.shadowOffsetX = 6 * scale;\n        ctx.shadowOffsetY = 8 * scale;\n        ctx.fillStyle = '#0a0a12';\n        ctx.fillRect(sx, sy, sw, sh);\n        ctx.restore();\n      }\n      if (style === 'gradient') { const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height); grad.addColorStop(0, gradient1); grad.addColorStop(1, gradient2); ctx.fillStyle = grad; } else { ctx.fillStyle = color; }\n      if (style === 'rounded') { const r = Math.round(Math.min(sw, sh) * (radius / 100)); drawRoundedRect(ctx, 0, 0, canvas.width, canvas.height, r + Math.round(bw * scale)); ctx.fill(); } else { ctx.fillRect(0, 0, canvas.width, canvas.height); }\n      if (style === 'rounded') { const r = Math.round(Math.min(sw, sh) * (radius / 100)); ctx.save(); ctx.beginPath(); roundRect(ctx, sx, sy, sw, sh, r); ctx.clip(); ctx.drawImage(img, sx, sy, sw, sh); ctx.restore(); } else { ctx.drawImage(img, sx, sy, sw, sh); }\n    }\n\n    function drawRoundedRect(ctx, x, y, w, h, r) { ctx.beginPath(); roundRect(ctx, x, y, w, h, r); ctx.closePath(); }\n    function roundRect(ctx, x, y, w, h, r) { ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.quadraticCurveTo(x+w,y,x+w,y+r); ctx.lineTo(x+w,y+h-r); ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h); ctx.lineTo(x+r,y+h); ctx.quadraticCurveTo(x,y+h,x,y+h-r); ctx.lineTo(x,y+r); ctx.quadraticCurveTo(x,y,x+r,y); }\n\n    function renderPreview() {\n      if (!state.images.length) return;\n      const img = state.images[state.activeIndex]; if (!img) return;\n      const canvas = document.getElementById('previewCanvas');\n      renderToCanvas(canvas, img.img, { style: state.style, width: state.width, color: state.color, gradient1: state.gradient1, gradient2: state.gradient2, radius: state.radius, shadow: document.getElementById('shadowToggle').checked, socialPreset: state.socialPreset }, true);\n    }\n\n    // ===== Download =====\n    function downloadImage() {\n      if (!state.images.length) return; const img = state.images[state.activeIndex]; if (!img) return;\n      const canvas = document.createElement('canvas');\n      renderToCanvas(canvas, img.img, { style: state.style, width: state.width, color: state.color, gradient1: state.gradient1, gradient2: state.gradient2, radius: state.radius, shadow: document.getElementById('shadowToggle').checked, socialPreset: state.socialPreset }, false);\n      let mimeType = 'image/png', ext = 'png', quality;\n      if (state.format === 'jpeg') { mimeType = 'image/jpeg'; ext = 'jpg'; quality = parseInt(document.getElementById('jpegQuality').value) / 100; }\n      else if (state.format === 'webp') { mimeType = 'image/webp'; ext = 'webp'; quality = 0.92; }\n      canvas.toBlob((blob) => { const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = img.name.replace(/\\.[^.]+$/, '') + '-bordered.' + ext; document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url); }, mimeType, quality);\n    }\n\n    // ===== Batch =====\n    function updateBatchUI() {\n      const batchArea = document.getElementById('batchArea'), batchList = document.getElementById('batchList'), batchBtn = document.getElementById('batchDownloadBtn');\n      if (state.images.length <= 1) { batchArea.classList.remove('active'); batchBtn.style.display = 'none'; return; }\n      batchArea.classList.add('active'); batchBtn.style.display = ''; batchList.innerHTML = '';\n      state.images.forEach((img, i) => {\n        const thumb = document.createElement('canvas'); thumb.width = 56; thumb.height = 56;\n        thumb.className = 'batch-thumb' + (i === state.activeIndex ? ' active' : '');\n        const ctx = thumb.getContext('2d');\n        const ratio = Math.min(56 / img.img.width, 56 / img.img.height);\n        const tw = Math.round(img.img.width * ratio), th = Math.round(img.img.height * ratio);\n        ctx.drawImage(img.img, (56 - tw) / 2, (56 - th) / 2, tw, th);\n        thumb.addEventListener('click', () => { state.activeIndex = i; document.querySelectorAll('.batch-thumb').forEach(t => t.classList.remove('active')); thumb.classList.add('active'); renderPreview(); });\n        batchList.appendChild(thumb);\n      });\n    }\n\n    function downloadBatch() {\n      if (state.images.length <= 1) return;\n      const progress = document.getElementById('batchProgress'), progressBar = document.getElementById('batchProgressBar');\n      progress.classList.add('active'); let processed = 0; const total = state.images.length, results = [];\n      let mimeType = 'image/png', ext = 'png', quality;\n      if (state.format === 'jpeg') { mimeType = 'image/jpeg'; ext = 'jpg'; quality = parseInt(document.getElementById('jpegQuality').value) / 100; }\n      else if (state.format === 'webp') { mimeType = 'image/webp'; ext = 'webp'; quality = 0.92; }\n      const opts = { style: state.style, width: state.width, color: state.color, gradient1: state.gradient1, gradient2: state.gradient2, radius: state.radius, shadow: document.getElementById('shadowToggle').checked, socialPreset: state.socialPreset };\n      function processNext(i) {\n        if (i >= total) { results.forEach(r => { const url = URL.createObjectURL(r.blob); const a = document.createElement('a'); a.href = url; a.download = r.name; document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url); }); progress.classList.remove('active'); return; }\n        const canvas = document.createElement('canvas'); renderToCanvas(canvas, state.images[i].img, opts, false);\n        canvas.toBlob((blob) => { results.push({ blob, name: state.images[i].name.replace(/\\.[^.]+$/, '') + '-bordered.' + ext }); processed++; progressBar.style.width = Math.round((processed / total) * 100) + '%'; setTimeout(() => processNext(i + 1), 100); }, mimeType, quality);\n      }\n      processNext(0);\n    }\n\n    // ===== FAQ =====\n    function toggleFaq(el) { el.closest('.faq-item').classList.toggle('open'); }\n\n    // ===== Shadow Sync =====\n    document.getElementById('shadowToggle').addEventListener('change', () => { state.shadow = document.getElementById('shadowToggle').checked; });\n\n    // ===== Exit Intent Popup =====\n    (function() {\n      const overlay = document.getElementById('exitOverlay');\n      const closeBtn = document.getElementById('exitClose');\n      const ctaBtn = document.getElementById('exitCta');\n      const skipBtn = document.getElementById('exitSkip');\n      let shown = false;\n\n      function showExit() {\n        if (shown) return;\n        if (state.images.length > 0) return; // user is actively using the tool\n        shown = true;\n        overlay.classList.add('active');\n      }\n      function hideExit() { overlay.classList.remove('active'); }\n\n      document.addEventListener('mouseout', (e) => {\n        if (e.clientY <= 0 && !e.relatedTarget) showExit();\n      });\n      closeBtn.addEventListener('click', hideExit);\n      skipBtn.addEventListener('click', hideExit);\n      overlay.addEventListener('click', (e) => { if (e.target === overlay) hideExit(); });\n      ctaBtn.addEventListener('click', () => {\n        hideExit();\n        document.getElementById('tool').scrollIntoView({ behavior: 'smooth' });\n        setTimeout(() => { if (fileInput) fileInput.click(); }, 600);\n      });\n    })();\n\n    // ===== Newsletter Form =====\n    function handleNewsletter(e) {\n      e.preventDefault();\n      const form = document.getElementById('newsletterForm');\n      const email = form.querySelector('input[type=\"email\"]').value;\n      const success = document.getElementById('newsletterSuccess');\n      // Store email locally for now — connect to Mailchimp/Formspree later\n      const emails = JSON.parse(localStorage.getItem('adborder_newsletter') || '[]');\n      if (!emails.includes(email)) {\n        emails.push(email);\n        localStorage.setItem('adborder_newsletter', JSON.stringify(emails));\n      }\n      form.style.display = 'none';\n      success.style.display = 'block';\n      return false;\n    }\n\n    // ===== Tool Tab Switching =====\n    function switchTab(tab) {\n      const tabs = document.querySelectorAll('.tool-tab');\n      const checkerPanel = document.getElementById('sizeCheckerPanel');\n      const toolContainer = document.querySelector('.tool-container');\n\n      tabs.forEach(t => t.classList.remove('active'));\n\n      if (tab === 'border') {\n        tabs[0].classList.add('active');\n        toolContainer.style.display = '';\n        checkerPanel.classList.remove('active');\n        // Stop SC particles, restart border particles\n        if (scParticleAnimId) { cancelAnimationFrame(scParticleAnimId); scParticleAnimId = null; }\n        if (!particleAnimId && !state.images.length) animateParticles();\n      } else {\n        tabs[1].classList.add('active');\n        toolContainer.style.display = 'none';\n        checkerPanel.classList.add('active');\n        // Stop border particles, restart SC particles (reinit canvas since it was display:none)\n        if (particleAnimId) { cancelAnimationFrame(particleAnimId); particleAnimId = null; }\n        if (scParticleAnimId) { cancelAnimationFrame(scParticleAnimId); scParticleAnimId = null; }\n        if (!scImage) { resizeScCanvas(); initScParticles(); animateScParticles(); }\n      }\n    }\n\n    // ===== Size Checker =====\n    const SC_PLATFORMS = [\n      {\n        name: 'Instagram', icon: '\\ud83d\\udcf8',\n        formats: [\n          { name: 'Feed Post', w: 1080, h: 1080, ratio: '1:1' },\n          { name: 'Feed Portrait', w: 1080, h: 1350, ratio: '4:5' },\n          { name: 'Story / Reel', w: 1080, h: 1920, ratio: '9:16' }\n        ]\n      },\n      {\n        name: 'Twitter / X', icon: '\\ud83d\\udc26',\n        formats: [\n          { name: 'Post Image', w: 1200, h: 675, ratio: '16:9' },\n          { name: 'Header', w: 1500, h: 500, ratio: '3:1' },\n          { name: 'Profile', w: 400, h: 400, ratio: '1:1' }\n        ]\n      },\n      {\n        name: 'Facebook', icon: '\\ud83d\\udc64',\n        formats: [\n          { name: 'Post', w: 1200, h: 630, ratio: '1.91:1' },\n          { name: 'Cover Photo', w: 820, h: 312, ratio: '2.63:1' },\n          { name: 'Profile', w: 170, h: 170, ratio: '1:1' },\n          { name: 'Story', w: 1080, h: 1920, ratio: '9:16' }\n        ]\n      },\n      {\n        name: 'Pinterest', icon: '\\ud83d\\udccc',\n        formats: [\n          { name: 'Standard Pin', w: 1000, h: 1500, ratio: '2:3' },\n          { name: 'Profile', w: 165, h: 165, ratio: '1:1' }\n        ]\n      },\n      {\n        name: 'LinkedIn', icon: '\\ud83d\\udcbc',\n        formats: [\n          { name: 'Post', w: 1200, h: 627, ratio: '1.91:1' },\n          { name: 'Cover', w: 1584, h: 396, ratio: '4:1' },\n          { name: 'Profile', w: 400, h: 400, ratio: '1:1' }\n        ]\n      },\n      {\n        name: 'YouTube', icon: '\\u25b6\\ufe0f',\n        formats: [\n          { name: 'Thumbnail', w: 1280, h: 720, ratio: '16:9' },\n          { name: 'Banner', w: 2560, h: 1440, ratio: '16:9' },\n          { name: 'Profile', w: 800, h: 800, ratio: '1:1' }\n        ]\n      }\n    ];\n\n    let scImage = null;\n\n    // Upload handling\n    const scUploadEl = document.getElementById('scUpload');\n    const scFileInput = document.getElementById('scFileInput');\n    const scPreview = document.getElementById('scPreview');\n\n    scUploadEl.addEventListener('click', () => { if (!scImage) scFileInput.click(); });\n    scUploadEl.addEventListener('dragover', (e) => { e.preventDefault(); scUploadEl.classList.add('dragover'); });\n    scUploadEl.addEventListener('dragleave', () => { scUploadEl.classList.remove('dragover'); });\n    scUploadEl.addEventListener('drop', (e) => {\n      e.preventDefault(); scUploadEl.classList.remove('dragover');\n      if (e.dataTransfer.files.length) handleScFile(e.dataTransfer.files[0]);\n    });\n    scFileInput.addEventListener('change', (e) => { if (e.target.files.length) handleScFile(e.target.files[0]); });\n\n    // ===== SC Particle System =====\n    const scCanvas = document.getElementById('scCanvas');\n    const scCtx = scCanvas.getContext('2d');\n    let scParticles = [];\n    let scMouseX = -999, scMouseY = -999;\n    let scParticleAnimId = null;\n\n    function resizeScCanvas() {\n      const r = scUploadEl.getBoundingClientRect();\n      scCanvas.width = r.width;\n      scCanvas.height = r.height;\n    }\n    resizeScCanvas();\n    window.addEventListener('resize', resizeScCanvas);\n\n    scUploadEl.addEventListener('mousemove', (e) => {\n      const r = scUploadEl.getBoundingClientRect();\n      scMouseX = e.clientX - r.left;\n      scMouseY = e.clientY - r.top;\n    });\n    scUploadEl.addEventListener('mouseleave', () => { scMouseX = -999; scMouseY = -999; });\n\n    const SC_PARTICLE_COUNT = 55;\n    const scPalette = [\n      {r:6,g:182,b:212},    // cyan\n      {r:124,g:58,b:237},   // purple\n      {r:244,g:63,b:94},    // pink\n      {r:34,g:211,b:238},   // light cyan\n      {r:167,g:139,b:250}   // light purple\n    ];\n\n    function initScParticles() {\n      scParticles = [];\n      for (let i = 0; i < SC_PARTICLE_COUNT; i++) {\n        const c = scPalette[Math.floor(Math.random() * scPalette.length)];\n        scParticles.push({\n          x: Math.random() * scCanvas.width,\n          y: Math.random() * scCanvas.height,\n          vx: (Math.random() - 0.5) * 0.35,\n          vy: (Math.random() - 0.5) * 0.35,\n          r: Math.random() * 2.2 + 0.8,\n          baseR: Math.random() * 2.2 + 0.8,\n          c,\n          alpha: Math.random() * 0.35 + 0.15,\n          baseAlpha: Math.random() * 0.35 + 0.15\n        });\n      }\n    }\n    initScParticles();\n\n    function animateScParticles() {\n      scCtx.clearRect(0, 0, scCanvas.width, scCanvas.height);\n      const hovering = scMouseX > -500;\n\n      for (let i = 0; i < scParticles.length; i++) {\n        const p = scParticles[i];\n        if (hovering) {\n          const dx = scMouseX - p.x;\n          const dy = scMouseY - p.y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          if (dist < 140) {\n            const force = (140 - dist) / 140 * 0.02;\n            p.vx += dx * force;\n            p.vy += dy * force;\n            p.r = p.baseR + (140 - dist) / 140 * 2.5;\n            p.alpha = Math.min(p.baseAlpha + (140 - dist) / 140 * 0.35, 0.85);\n          } else {\n            p.r += (p.baseR - p.r) * 0.04;\n            p.alpha += (p.baseAlpha - p.alpha) * 0.04;\n          }\n        } else {\n          p.r += (p.baseR - p.r) * 0.04;\n          p.alpha += (p.baseAlpha - p.alpha) * 0.04;\n        }\n\n        p.x += p.vx;\n        p.y += p.vy;\n        p.vx *= 0.985;\n        p.vy *= 0.985;\n\n        if (p.x < -15) p.x = scCanvas.width + 15;\n        if (p.x > scCanvas.width + 15) p.x = -15;\n        if (p.y < -15) p.y = scCanvas.height + 15;\n        if (p.y > scCanvas.height + 15) p.y = -15;\n\n        const glowR = p.r * 3.5;\n        const grad = scCtx.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowR);\n        grad.addColorStop(0, 'rgba(' + p.c.r + ',' + p.c.g + ',' + p.c.b + ',' + (p.alpha * 0.3) + ')');\n        grad.addColorStop(1, 'rgba(' + p.c.r + ',' + p.c.g + ',' + p.c.b + ',0)');\n        scCtx.fillStyle = grad;\n        scCtx.beginPath();\n        scCtx.arc(p.x, p.y, glowR, 0, Math.PI * 2);\n        scCtx.fill();\n\n        scCtx.fillStyle = 'rgba(' + p.c.r + ',' + p.c.g + ',' + p.c.b + ',' + p.alpha + ')';\n        scCtx.beginPath();\n        scCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);\n        scCtx.fill();\n      }\n\n      for (let i = 0; i < scParticles.length; i++) {\n        for (let j = i + 1; j < scParticles.length; j++) {\n          const dx = scParticles[i].x - scParticles[j].x;\n          const dy = scParticles[i].y - scParticles[j].y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          if (dist < 80) {\n            const alpha = (1 - dist / 80) * 0.1;\n            scCtx.strokeStyle = 'rgba(217,119,6,' + alpha + ')';\n            scCtx.lineWidth = 0.5;\n            scCtx.beginPath();\n            scCtx.moveTo(scParticles[i].x, scParticles[i].y);\n            scCtx.lineTo(scParticles[j].x, scParticles[j].y);\n            scCtx.stroke();\n          }\n        }\n      }\n\n      if (hovering) {\n        const mg = scCtx.createRadialGradient(scMouseX, scMouseY, 0, scMouseX, scMouseY, 50);\n        mg.addColorStop(0, 'rgba(217,119,6,0.07)');\n        mg.addColorStop(0.5, 'rgba(13,148,136,0.03)');\n        mg.addColorStop(1, 'rgba(0,0,0,0)');\n        scCtx.fillStyle = mg;\n        scCtx.beginPath();\n        scCtx.arc(scMouseX, scMouseY, 50, 0, Math.PI * 2);\n        scCtx.fill();\n      }\n\n      scParticleAnimId = requestAnimationFrame(animateScParticles);\n    }\n    animateScParticles();\n\n    // SC Demo image cycling\n    const scDemoImgs = document.querySelectorAll('.sc-demo-img');\n    let scDemoIndex = 0;\n    setInterval(() => {\n      if (!scUploadEl || scUploadEl.classList.contains('has-image')) return;\n      scDemoImgs.forEach(img => img.classList.remove('active'));\n      scDemoIndex = (scDemoIndex + 1) % scDemoImgs.length;\n      scDemoImgs[scDemoIndex].classList.add('active');\n    }, 3500);\n\n    function handleScFile(file) {\n      if (!file.type.startsWith('image/')) return;\n      const reader = new FileReader();\n      reader.onload = (e) => {\n        const img = new Image();\n        img.onload = () => {\n          scImage = img;\n          scPreview.src = e.target.result;\n          scUploadEl.classList.add('has-image');\n          if (scParticleAnimId) { cancelAnimationFrame(scParticleAnimId); scParticleAnimId = null; }\n          analyzeImage(img);\n        };\n        img.src = e.target.result;\n      };\n      reader.readAsDataURL(file);\n    }\n\n    function analyzeImage(img) {\n      const w = img.width, h = img.height;\n      const imgRatio = w / h;\n      let totalScore = 0;\n      let totalFormats = 0;\n\n      const grid = document.getElementById('scGrid');\n      grid.innerHTML = '';\n\n      SC_PLATFORMS.forEach(platform => {\n        let platformScore = 0;\n        const formatHtml = platform.formats.map(fmt => {\n          const fmtRatio = fmt.w / fmt.h;\n          const ratioDiff = Math.abs(imgRatio - fmtRatio) / fmtRatio;\n          const resolutionOk = w >= fmt.w * 0.5 && h >= fmt.h * 0.5;\n          let status, statusIcon, score;\n\n          if (ratioDiff < 0.05 && resolutionOk) {\n            status = 'Perfect'; statusIcon = '\\u2705'; score = 100;\n          } else if (ratioDiff < 0.15 && resolutionOk) {\n            status = 'Good'; statusIcon = '\\ud83d\\udfe1'; score = 70;\n          } else if (ratioDiff < 0.3) {\n            status = 'Croppable'; statusIcon = '\\ud83d\\udfe0'; score = 40;\n          } else {\n            status = 'Poor fit'; statusIcon = '\\u274c'; score = 10;\n          }\n\n          platformScore += score;\n          totalScore += score;\n          totalFormats++;\n\n          return '<li class=\"sc-format-item\">' +\n            '<span class=\"sc-format-status\">' + statusIcon + '</span>' +\n            '<span class=\"sc-format-name\">' + fmt.name + '</span>' +\n            '<span class=\"sc-format-size\">' + fmt.w + '\\u00d7' + fmt.h + ' (' + fmt.ratio + ')</span>' +\n          '</li>';\n        }).join('');\n\n        const avgScore = Math.round(platformScore / platform.formats.length);\n        const scoreClass = avgScore >= 70 ? 'perfect' : avgScore >= 40 ? 'good' : 'poor';\n\n        grid.innerHTML += '<div class=\"sc-card\">' +\n          '<div class=\"sc-card-header\">' +\n            '<span class=\"sc-card-icon\">' + platform.icon + '</span>' +\n            '<span class=\"sc-card-name\">' + platform.name + '</span>' +\n            '<span class=\"sc-card-score ' + scoreClass + '\">' + avgScore + '</span>' +\n          '</div>' +\n          '<ul class=\"sc-format-list\">' + formatHtml + '</ul>' +\n        '</div>';\n      });\n\n      const overall = Math.round(totalScore / totalFormats);\n      document.getElementById('scOverallScore').textContent = overall;\n      document.getElementById('scResults').classList.add('active');\n    }\n\n    function resetSizeChecker() {\n      scImage = null;\n      scUploadEl.classList.remove('has-image');\n      document.getElementById('scResults').classList.remove('active');\n      scFileInput.value = '';\n      if (!scParticleAnimId) animateScParticles();\n    }\n\n    function generateShareCard() {\n      if (!scImage) return;\n      const canvas = document.createElement('canvas');\n      canvas.width = 1080; canvas.height = 1080;\n      const ctx = canvas.getContext('2d');\n\n      // Background\n      ctx.fillStyle = '#0a0a12';\n      ctx.fillRect(0, 0, 1080, 1080);\n\n      // Gradient border\n      const grad = ctx.createLinearGradient(0, 0, 1080, 1080);\n      grad.addColorStop(0, '#0d9488'); grad.addColorStop(1, '#d97706');\n      ctx.strokeStyle = grad; ctx.lineWidth = 6;\n      ctx.strokeRect(30, 30, 1020, 1020);\n\n      // Title\n      ctx.fillStyle = '#e8e8f0';\n      ctx.font = 'bold 36px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('My Social Media Image Score', 540, 100);\n\n      // Overall score\n      const overall = document.getElementById('scOverallScore').textContent;\n      ctx.font = 'bold 120px sans-serif';\n      const scoreGrad = ctx.createLinearGradient(340, 120, 740, 280);\n      scoreGrad.addColorStop(0, '#5eead4'); scoreGrad.addColorStop(1, '#fbbf24');\n      ctx.fillStyle = scoreGrad;\n      ctx.fillText(overall, 540, 260);\n\n      ctx.font = '20px sans-serif';\n      ctx.fillStyle = '#8888a0';\n      ctx.fillText('Overall Score', 540, 295);\n\n      // Platform scores\n      const cards = document.querySelectorAll('.sc-card');\n      const startY = 350;\n      const colW = 340;\n      const rowH = 100;\n      cards.forEach((card, i) => {\n        const col = i % 2;\n        const row = Math.floor(i / 2);\n        const x = 80 + col * colW;\n        const y = startY + row * rowH;\n\n        const name = card.querySelector('.sc-card-name').textContent;\n        const score = card.querySelector('.sc-card-score').textContent;\n        const icon = card.querySelector('.sc-card-icon').textContent;\n\n        ctx.font = '28px sans-serif';\n        ctx.textAlign = 'left';\n        ctx.fillStyle = '#e8e8f0';\n        ctx.fillText(icon + ' ' + name, x, y + 30);\n\n        ctx.font = 'bold 36px sans-serif';\n        ctx.textAlign = 'right';\n        const sc = parseInt(score);\n        ctx.fillStyle = sc >= 70 ? '#10b981' : sc >= 40 ? '#f59e0b' : '#ef4444';\n        ctx.fillText(score, x + 300, y + 35);\n\n        // Separator line\n        ctx.strokeStyle = 'rgba(255,255,255,0.06)'; ctx.lineWidth = 1;\n        ctx.beginPath(); ctx.moveTo(x, y + 55); ctx.lineTo(x + 320, y + 55); ctx.stroke();\n      });\n\n      // Image thumbnail\n      const thumbSize = 160;\n      const thumbX = 540 - thumbSize / 2;\n      const thumbY = 700;\n      ctx.save();\n      ctx.beginPath();\n      ctx.roundRect(thumbX, thumbY, thumbSize, thumbSize, 12);\n      ctx.clip();\n      const scale = Math.min(thumbSize / scImage.width, thumbSize / scImage.height);\n      const tw = scImage.width * scale, th = scImage.height * scale;\n      ctx.drawImage(scImage, thumbX + (thumbSize - tw) / 2, thumbY + (thumbSize - th) / 2, tw, th);\n      ctx.restore();\n\n      // Image dimensions\n      ctx.font = '18px monospace'; ctx.textAlign = 'center'; ctx.fillStyle = '#8888a0';\n      ctx.fillText(scImage.width + ' \\u00d7 ' + scImage.height, 540, 890);\n\n      // Branding\n      ctx.font = 'bold 28px sans-serif'; ctx.textAlign = 'center';\n      const brandGrad = ctx.createLinearGradient(340, 940, 740, 970);\n      brandGrad.addColorStop(0, '#5eead4'); brandGrad.addColorStop(1, '#fbbf24');\n      ctx.fillStyle = brandGrad;\n      ctx.fillText('adborder.top', 540, 960);\n\n      ctx.font = '16px sans-serif'; ctx.fillStyle = '#555570';\n      ctx.fillText('Free Social Media Image Size Checker', 540, 990);\n\n      // Download\n      canvas.toBlob((blob) => {\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url; a.download = 'social-media-score.png';\n        document.body.appendChild(a); a.click(); document.body.removeChild(a);\n        URL.revokeObjectURL(url);\n      }, 'image/png');\n    }\n\n  </script>\n\n  "
}
